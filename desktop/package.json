{
  "name": "agentgit-desktop",
  "productName": "AgentGit",
  "version": "0.1.7",
  "description": "AgentGit 执行历史、隔离分支与回放桌面应用",
  "author": "AgentGit",
  "license": "UNLICENSED",
  "private": true,
  "main": ".build/main/index.js",
  "engines": {
    "node": "24.19.0",
    "npm": "12.1.0"
  },
  "packageManager": "npm@12.1.0",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node scripts/generate-notices.cjs && vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "dev": "npm start",
    "setup": "node node_modules/electron/install.js",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "test:electron": "npm run build && playwright test",
    "test:electron:real": "npm run build && playwright test --config playwright.real.config.ts",
    "test:electron:install": "playwright test --config playwright.install.config.ts",
    "package": "npm run build && electron-forge package --platform=win32 --arch=x64",
    "make": "npm run build && electron-forge make --platform=win32 --arch=x64"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xyflow/react": "12.12.0",
    "electron": "45.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  }
}
