# 仅为本地开发提供的公开占位凭据，不用于外部服务。
AGENTGIT_DATABASE_URL=postgresql+psycopg://agentgit:agentgit_local@127.0.0.1:55432/agentgit_dev
AGENTGIT_TEST_DATABASE_URL=postgresql+psycopg://agentgit:agentgit_local@127.0.0.1:55432/agentgit_test
AGENTGIT_DATA_ROOT=.agentgit/dev
AGENTGIT_TEST_DATA_ROOT=.agentgit/test
AGENTGIT_OPERATOR_ID=local-operator
# API 令牌须在本机进程环境生成，勿提交真实值；程序不会自动加载本文件。
# AGENTGIT_API_TOKEN=<至少32个可见ASCII字符>
# AGENTGIT_API_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
