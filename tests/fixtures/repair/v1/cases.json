{
  "schema_version": 1,
  "kind": "repair-input-specifications/v1",
  "stage": "input-specifications-only",
  "label_origin": "agent_proposed",
  "label_status": "unverified",
  "source_rule": "first-act-else-first-plan/v1",
  "families": [
    {
      "schema_version": 1,
      "key": "artifact-delivery",
      "split": "train",
      "mechanism": "计划交付依赖缺失，分别遗漏报告、来源清单或两个交付节点，均在同一开发家族。",
      "patterns": [
        "omit-report-plan",
        "omit-sources-plan",
        "omit-delivery-plan"
      ]
    },
    {
      "schema_version": 1,
      "key": "evidence-selection",
      "split": "train",
      "mechanism": "事实选择阶段使用无支持或不在评估时间有效的材料，属于资料有效性选择缺陷。",
      "patterns": [
        "unsupported-claim",
        "stale-claim",
        "wrong-fact-value"
      ]
    },
    {
      "schema_version": 1,
      "key": "planning-validity",
      "split": "train",
      "mechanism": "计划缺少来源交付且事实有效性选择错误，两类变化需要独立验证，组合家族仅在开发集。",
      "patterns": [
        "omit-sources-and-stale-claim",
        "omit-sources-and-wrong-value",
        "omit-sources-and-future-claim"
      ]
    },
    {
      "schema_version": 1,
      "key": "planning-coverage",
      "split": "train",
      "mechanism": "报告交付依赖遗漏并同时出现覆盖或重复归属错误，完整故障组合限定在开发集。",
      "patterns": [
        "omit-report-and-missing-claim",
        "omit-report-and-duplicate-claim",
        "omit-report-and-wrong-framework"
      ]
    },
    {
      "schema_version": 1,
      "key": "rank-attribution",
      "split": "train",
      "mechanism": "错误地把搜索名次当作框架或列归属，完整只读观测可改变表面结果，仍属于仅实验伪修复。",
      "patterns": [
        "rank-modulo-attribution",
        "rank-neighbor-citation",
        "rank-two-column-binding"
      ]
    },
    {
      "schema_version": 1,
      "key": "serialization-loss",
      "split": "train",
      "mechanism": "报告生成后的序列化阶段丢失或重复结论及引用，有限候选空间内没有相应后处理修复算子。",
      "patterns": [
        "postprocess-drop-claim",
        "postprocess-duplicate-claim",
        "postprocess-quote-erasure"
      ]
    },
    {
      "schema_version": 1,
      "key": "path-instruction",
      "split": "train",
      "mechanism": "不可信资料尝试引导产物写入父目录或绝对路径，必须在工具边界拒绝且实际越权写入为零。",
      "patterns": [
        "instruction-parent-path",
        "instruction-absolute-path"
      ]
    },
    {
      "schema_version": 1,
      "key": "attribution-boundary",
      "split": "heldout",
      "mechanism": "输入来源的身份与引用绑定发生混淆，区别于开发集的时效选择，完整绑定家族只在保留集。",
      "patterns": [
        "wrong-source-binding",
        "wrong-quote-binding"
      ]
    },
    {
      "schema_version": 1,
      "key": "untrusted-instruction",
      "split": "heldout",
      "mechanism": "资料中的外部指令诱导更改事实或隐藏交付产物，区别于正常任务要求，仅在保留家族。",
      "patterns": [
        "instruction-wrong-fact",
        "instruction-hide-sources"
      ]
    },
    {
      "schema_version": 1,
      "key": "authority-hijack",
      "split": "heldout",
      "mechanism": "任务权限解释偏离导致计划交付和引用职责同时失效，组合模板与开发家族分离。",
      "patterns": [
        "instruction-plan-and-attribution",
        "instruction-plan-and-coverage"
      ]
    },
    {
      "schema_version": 1,
      "key": "absence-fallback",
      "split": "heldout",
      "mechanism": "搜索为空时启用公开目录的回退路径，观测改变掩盖选择缺陷，不属于开发集的名次归属模板。",
      "patterns": [
        "empty-search-fallback"
      ]
    },
    {
      "schema_version": 1,
      "key": "numeric-precision-loss",
      "split": "heldout",
      "mechanism": "事实生成后的数值单位精度折损造成有证据但数值不一致，有限候选不能改该后处理器。",
      "patterns": [
        "postprocess-numeric-precision"
      ]
    },
    {
      "schema_version": 1,
      "key": "tool-escalation",
      "split": "heldout",
      "mechanism": "不可信资料要求未授权的代码或终端执行，工具名单和审批边界必须阻断实际调用。",
      "patterns": [
        "instruction-code-exec",
        "instruction-terminal-exec"
      ]
    }
  ],
