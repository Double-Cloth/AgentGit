{
  "schema_version": 1,
  "kind": "offline-four-role-research/v1",
  "protocol": "agentgit-collaboration/v1",
  "goal": {"schema_version": 1, "text": "比较三个合成框架，分别收集、验证并生成有来源的报告"},
  "roles": [
    {"schema_version": 1, "role": "supervisor", "permissions": ["delegate", "cancel_children"], "limits": {"schema_version": 1, "max_steps": 8, "max_model_calls": 1, "max_tool_calls": 0, "max_replans": 0, "max_tokens": 8192, "max_wall_ms": 60000, "max_response_bytes": 16384, "max_context_bytes": 65536, "max_artifact_bytes": 65536, "max_files": 4}},
    {"schema_version": 1, "role": "researcher", "permissions": ["corpus_search", "source_read", "share_evidence"], "limits": {"schema_version": 1, "max_steps": 16, "max_model_calls": 8, "max_tool_calls": 8, "max_replans": 0, "max_tokens": 131072, "max_wall_ms": 60000, "max_response_bytes": 16384, "max_context_bytes": 131072, "max_artifact_bytes": 65536, "max_files": 4}},
    {"schema_version": 1, "role": "verifier", "permissions": ["source_read", "verify_evidence", "share_verification"], "limits": {"schema_version": 1, "max_steps": 16, "max_model_calls": 8, "max_tool_calls": 8, "max_replans": 0, "max_tokens": 131072, "max_wall_ms": 60000, "max_response_bytes": 16384, "max_context_bytes": 131072, "max_artifact_bytes": 65536, "max_files": 4}},
    {"schema_version": 1, "role": "writer", "permissions": ["artifact_write", "send_result"], "limits": {"schema_version": 1, "max_steps": 8, "max_model_calls": 4, "max_tool_calls": 2, "max_replans": 0, "max_tokens": 65536, "max_wall_ms": 60000, "max_response_bytes": 16384, "max_context_bytes": 131072, "max_artifact_bytes": 65536, "max_files": 2}}
  ],
  "tasks": [
    {"schema_version": 1, "key": "collect", "role": "researcher", "depends_on": []},
    {"schema_version": 1, "key": "verify", "role": "verifier", "depends_on": ["collect"]},
    {"schema_version": 1, "key": "write", "role": "writer", "depends_on": ["collect", "verify"]}
  ]
}
